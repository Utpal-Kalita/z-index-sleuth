  "diff": "diff --git a/baseline/fixture.css b/public/fixture/fixture.css\nindex 630b592..8f83ba1 100644\n--- a/baseline/fixture.css\n+++ b/public/fixture/fixture.css\n@@ -29,7 +29,7 @@ button:hover {\n   background: #2563eb;\n }\n \n-/* BASELINE BUG: aria-hidden loading overlay with opacity:0 and pointer-events:auto */\n+/* FIX: When the loading overlay is aria-hidden (inactive), pointer-events must be none so it does not intercept clicks on the underlying button. When active (aria-hidden=false), pointer-events remains auto to block interaction. */\n .loading-overlay {\n   position: fixed;\n   top: 0;\n@@ -38,13 +38,17 @@ button:hover {\n   height: 100vh;\n   background: rgba(0, 0, 0, 0.5);\n   opacity: 0;\n-  pointer-events: auto; \n+  pointer-events: none; \n   display: flex;\n   justify-content: center;\n   align-items: center;\n   z-index: 9999;\n }\n \n+.loading-overlay[aria-hidden=\"false\"] {\n+  pointer-events: auto;\n+}\n+\n .spinner {\n   border: 4px solid rgba(255, 255, 255, 0.3);\n   width: 40px;\n",
